using namespace std;

class Student {
public:
    string name;
    int age;
    
    void showInfo() {
        cout << "Name: " << name << ", Age: " << age << endl;
    }
};

class FileHandler {
public:
    void createFile() {
        ofstream file("data.txt");
        file << "Hello, this is file content!\n";
        file << "Student Data Example\n";
        file.close();
        cout << "File created successfully.\n";
    }
    
    void readFile() {
        string line;
        ifstream file("data.txt");
        while (getline(file, line)) {
            cout << line << endl;
        }
        file.close();
    }
};

